NODE_ENV=development
PORT=3001
APP_NAME="Natural OS"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/naturalos?schema=public"

JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

BCRYPT_ROUNDS=10

FRONTEND_URL="http://localhost:3000"
